node_modules/
bun.lock
*.log

# The compiled package. Generated by `npm run build`, which `prepack` runs before
# every `npm pack`, so it is never committed and never stale in a tarball. What
# ships is dist/ -- see scripts/build.mjs for why the tarball cannot carry the
# TypeScript sources instead.
dist/

# The context map is a derived artifact, regenerated by context and
# resolved per project from the session directory. Committing it would churn on
# every session that edits a file; syncing it would push a description of this
# host's projects onto hosts that have different ones. See OPERATIONS.md.
.opencode/context/

# Credentials never belong here. opencode keeps auth in
# ~/.local/share/opencode/auth.json, outside this directory, but guard anyway.
auth.json
.env
.env.*
# ...except the template, which carries no host details and documents the vars.
!.env.example
*.pem
*.key

# The generated benchmark table. docs/BENCHMARKS.md beside it is HAND WRITTEN --
# the explainer that ships. A generated artifact is a local, dated result and
# must never be committed next to it as though it were a published measurement.
docs/BENCHMARKS.generated.md
*.tgz
