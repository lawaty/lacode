#!/usr/bin/env bash
# Local end of the oc-notify reverse tunnel. A remote host's `oc` reaches this
# over an SSH RemoteForward and passes the notification as SSH_ORIGINAL_COMMAND.
#
# This is wired into ~/.ssh/authorized_keys as a forced command with `restrict`,
# so the tunnel key can do exactly this and nothing else: no shell, no PTY, no
# agent or port forwarding. Do not relax those options.
#
# THE PAYLOAD IS $SSH_ORIGINAL_COMMAND, NOT THE POSITIONAL PARAMETERS.
#
# OpenSSH concatenates every argument after the host into ONE command string, and
# a forced command is started with no arguments of its own. A receiver that reads
# "$1".."$4" therefore sees four empty strings, falls back to four defaults, and
# pops up an empty notification -- which is exactly what this script used to do.
# The sender therefore passes a SINGLE argument of the form:
#
#     title\nmessage\nurgency\nicon\nsound\nrequestID
#
# NEWLINE is the delimiter because both senders strip control characters from the
# title and the message before assembling the payload, so no field can contain
# one. The sender and this receiver are versioned together; oc-sync installs both.
#
# The request id -- the SIXTH field -- is what makes the notification
# ACTIONABLE: with one, the popup carries buttons and the chosen button's name
# comes back on stdout; without one, it is a plain notice. It is opaque -- it
# is never passed to a command, never echoed, and never used to build an
# argument. Only its emptiness is ever tested.
#
# The FIFTH field is the sound, and it is ignored here: this receiver has no
# sounds directory to play it from. The field is still carried, so the legacy
# sender and the published one put the same thing on the wire.
#
# A payload with fewer than six fields carries no request id, and therefore no
# buttons -- so an older sender still works against this receiver.
#
# $SSH_ORIGINAL_COMMAND is ATTACKER-CONTROLLED: it is whatever the remote host's
# user typed on the ssh command line, and this script runs as the desktop user.
#
#   NEVER `eval "$SSH_ORIGINAL_COMMAND"`
#   NEVER `sh -c "$SSH_ORIGINAL_COMMAND"`
#   NEVER splice it into an argument list
#
# `restrict` in authorized_keys is the only thing containing that input, so it
# must stay DATA all the way to notify-send. Urgency and icon become command-line
# flags (--urgency=..., --icon=...), so an unvalidated value there is an injection
# risk in its own right; both are checked against a whitelist below.

set -uo pipefail

# Split on newlines only: no word splitting, so a message full of spaces survives
# intact, and no globbing, so a message full of `*` does too. The fields this
# receiver does not use are ignored -- not merged, not executed.
#
# A `while read` loop rather than `mapfile -t`, and the two are equivalent here:
# checked against empty input, a trailing newline, blank lines and a field full
# of spaces, the resulting arrays are identical. That matters because mapfile is
# bash 4.0+. On the bash 3.2 macOS ships -- and on a few minimal Linux images --
# `mapfile` was simply "command not found", `fields` stayed unset, and EVERY
# field fell back to its default: a popup titled "LaCode" with an empty body,
# raised with no error and no log line anywhere. That is the same silent blank
# notification the argv bug in the header comment already caused once, reached
# again through a different door, so the loop below is the fix rather than a
# portability nicety.
fields=()
while IFS= read -r field; do
  fields+=("$field")
done <<<"${SSH_ORIGINAL_COMMAND-}"

TITLE="${fields[0]:-LaCode}"
MSG="${fields[1]:-}"
URGENCY="${fields[2]:-normal}"
ICON="${fields[3]:-utilities-terminal}"
REQUEST_ID="${fields[5]:-}"

# Both senders already strip control characters; this is the trust boundary, so
# the check is repeated here rather than assumed from the other end.
TITLE="${TITLE//[[:cntrl:]]/ }"
MSG="${MSG//[[:cntrl:]]/ }"
# The request id is stripped for the same reason: it is a field in a payload
# that arrives from an attacker-controlled environment. It is never used to
# build an argument -- only its emptiness is ever tested.
REQUEST_ID="${REQUEST_ID//[[:cntrl:]]/ }"

# A payload with no newline at all is the OLD sender's argument list, already
# flattened by ssh into one space-joined string. That is the bug this receiver
# used to hit, and its symptom (an empty popup) points nowhere, so name it.
if [[ -n "${SSH_ORIGINAL_COMMAND-}" && "${#fields[@]}" -lt 2 ]]; then
  echo "oc-notify: payload is not newline-delimited; the remote's oc is older than this receiver (run oc-sync there)" >&2
fi

case "$URGENCY" in
  low|normal|critical) ;;
  *) URGENCY=normal ;;
esac

case "$ICON" in
  utilities-terminal|dialog-information|dialog-error|dialog-warning|system-run|emblem-default) ;;
  *) ICON=utilities-terminal ;;
esac

# This is the LINUX end of the hop: notify-send (libnotify) is the channel, and
# libnotify is a Linux thing. A machine with no notify-send is told so plainly
# and exits non-zero, rather than being handed a payload nothing will ever show.
#
# macOS has no notify-send, and a Mac cannot be this end of the tunnel: the
# persistent forward that reaches it is a systemd --user unit installed by
# oc-sync, so the whole desktop half of this hop is Linux-only by design. A Mac
# that wants notifications does not run this script at all.
#
# Both branches name the way out, because the failure is otherwise invisible:
# this runs as an authorized_keys forced command, so its stderr goes to whoever
# happened to open the ssh connection and to nobody else. A bare "command not
# found" read as a desktop that silently stopped notifying.
if ! command -v notify-send >/dev/null 2>&1; then
  if [[ "$(uname -s 2>/dev/null)" == "Darwin" ]]; then
    echo "oc-notify: this receiver delivers through notify-send, which macOS does not have." >&2
  else
    echo "oc-notify: notify-send is not installed on this machine (it ships with libnotify-bin / libnotify)." >&2
  fi
  echo "oc-notify: use the portable path instead -- 'lacode notify' picks the right channel for this platform and needs no receiver." >&2
  exit 127
fi

# notify-send exists, so this is a Linux session bus whatever it looks like.
# Fall back to the common X11 layouts only when the inherited environment has
# neither.
export DISPLAY="${DISPLAY:-:0}"
if [[ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]]; then
  export DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$(id -u)/bus"
fi

# An actionable notification carries buttons, so the user can answer without
# opening a terminal. notify-send then waits for the click and prints the
# chosen button's NAME on stdout; that stdout travels back down the ssh
# connection to the sender, which is how the answer reaches the caller. An
# empty answer means the popup was dismissed without choosing.
#
# The request id itself is not passed to notify-send and is not part of the
# output: it decided only that this notification has buttons. The notifier's
# stderr is left alone -- this runs as a forced command, so its stderr reaches
# whoever opened the ssh connection and nobody else.
if [[ -n "$REQUEST_ID" ]]; then
  action="$(notify-send "$TITLE" "$MSG" --urgency="$URGENCY" --icon="$ICON" --expire-time=0 --action=once='Allow once' --action=always='Always allow' --action=reject='Deny')" || exit 1
  printf '%s\n' "$action"
  exit 0
fi

# --expire-time=0: the notification waits for the user to close it; without it the desktop's own timeout takes it away, and a notice they missed is no notice.
exec notify-send "$TITLE" "$MSG" --urgency="$URGENCY" --icon="$ICON" --expire-time=0
