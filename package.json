{
  "name": "@lawaty/lacode",
  "version": "1.2.0",
  "description": "Ultimate opencode setup for Go users — cost-controlled pooled subagents, hang recovery, and notifications for opencode.",
  "license": "MIT",
  "type": "module",
  "author": {
    "name": "lawaty",
    "url": "https://github.com/lawaty"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lawaty/lacode.git"
  },
  "homepage": "https://github.com/lawaty/lacode#readme",
  "bugs": {
    "url": "https://github.com/lawaty/lacode/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "subagents",
    "cost-optimization",
    "model-pool",
    "notifications"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./server": "./dist/index.js",
    "./pool": "./dist/pool.js",
    "./agents": "./dist/agents.js",
    "./commands": "./dist/commands.js",
    "./tui": "./dist/tui.js",
    "./tunnel": "./dist/tunnel.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "lacode": "dist/lacode.js",
    "lacode-voice": "dist/lacode-voice.js"
  },
  "files": [
    "dist",
    "presets",
    "sounds",
    "LICENSE",
    "CHANGELOG.md",
    "README.md",
    "docs",
    "scripts/score-models.mjs"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "postpublish": "node scripts/sync-hosts.mjs",
    "test": "node --test tests/",
    "benchmark": "node tests/benchmark/run.mjs",
    "score": "node scripts/score-models.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "1.18.34"
  },
  "optionalDependencies": {
    "@picovoice/porcupine-node": "^4.0.2",
    "vosk": "^0.3.39"
  },
  "publishConfig": {
    "tag": "latest"
  }
}
